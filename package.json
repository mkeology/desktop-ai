{
  "name": "ai-workspace",
  "private": true,
  "description": "AI Workspace monorepo — apps/web (landing page) and apps/desktop (the Electron product).",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/desktop",
    "build": "npm run build --workspace apps/desktop",
    "start": "npm run start --workspace apps/desktop",
    "lint": "npm run lint --workspace apps/desktop",
    "test": "npm run test --workspace apps/desktop",
    "typecheck": "npm run typecheck --workspace apps/desktop",
    "dist": "npm run dist --workspace apps/desktop"
  }
}
